# Copy to .env and fill in. Never commit .env.

# This app's own database (Postgres, Prisma-managed, `prisma/app/schema.prisma`)
DATABASE_URL=postgres://portal:portal_dev_password@localhost:5435/wisp_portal

# The shared FreeRADIUS/daloRADIUS database (MariaDB, introspected read/write via `prisma/radius/schema.prisma`)
# Points at whatever host runs the daloRADIUS install from
# https://github.com/lirantal/daloradius/wiki/Install-daloRADIUS-on-Debian
RADIUS_DATABASE_URL=mysql://raduser:radpass@radius-host:3306/raddb

APP_BASE_URL=https://portal.example.com

# Which STK-push rail is live. Only that provider's vars below are required — see
# docs/PAYSTACK-INTEGRATION.md for why this app supports both.
PAYMENT_PROVIDER=mpesa

# Safaricom Daraja (M-Pesa Express / STK Push) — required when PAYMENT_PROVIDER=mpesa, see docs/MPESA-INTEGRATION.md
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Must be a public, HTTPS-reachable URL — Safaricom posts here directly
MPESA_CALLBACK_URL=https://portal.example.com/api/mpesa/callback

# Paystack (M-Pesa via their Charge API) — required when PAYMENT_PROVIDER=paystack, see docs/PAYSTACK-INTEGRATION.md
# Test vs. live mode is determined purely by the key prefix (sk_test_... vs sk_live_...), not a
# separate env var. Set the webhook URL in the Paystack dashboard, not here — Paystack has no
# per-request callback field: https://portal.example.com/api/paystack/webhook
PAYSTACK_SECRET_KEY=

# OPNsense captive portal (see docs/OPNSENSE-SETUP.md) — confirm port/path against the installed OPNsense version
OPNSENSE_CAPTIVE_PORTAL_BASE_URL=https://192.168.1.1:8003
OPNSENSE_DEFAULT_ZONE_ID=

# Minutes past a session's expiry before its RADIUS credentials are deleted by the cleanup job
RADIUS_CLEANUP_GRACE_MINUTES=10

# Shared secret the external scheduler sends as `Authorization: Bearer <value>` to POST /api/radius-cleanup
CRON_SECRET=
