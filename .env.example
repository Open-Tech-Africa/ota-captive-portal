# Copy to .env and fill in, then `chmod 600 .env`. Never commit .env — see .gitignore.
# Every var here is validated at startup by src/lib/env.ts; it will refuse to boot with a
# readable error if something required is missing.

# --- This app's own database (Postgres, prisma/app/schema.prisma) ---
DATABASE_URL=postgres://portal:portal_dev_password@localhost:5435/wisp_portal   # matches docker-compose's published port

# --- Shared RADIUS database (see docs/RADIUS-INTEGRATION.md) ---
# FreeRADIUS/daloRADIUS MariaDB; any syntactically valid URL works without real RADIUS infra —
# provisioning just fails gracefully. If MariaDB runs on THIS SAME machine (the common case, see
# docs/INSTALL.md §1 topology A): use `host.docker.internal`, never `localhost`/`127.0.0.1` —
# those resolve to the container itself from inside web-prod, not the host, and silently produce
# `PrismaClientInitializationError: Can't reach database server` after a real payment succeeds.
# Also create a dedicated DB user for this app (docs/INSTALL.md §4) — don't reuse daloRADIUS's own
# `raduser`, which is normally host-restricted and won't be reachable from Docker's bridge network.
RADIUS_DATABASE_URL=mysql://wispportal:changeme@host.docker.internal:3306/raddb

# --- This app's own public URL ---
APP_BASE_URL=https://portal.example.com   # used to build callback/webhook URLs and placeholder emails; your tunnel or domain URL

# --- Payment provider (see docs/MPESA-INTEGRATION.md and docs/PAYSTACK-INTEGRATION.md) ---
PAYMENT_PROVIDER=paystack   # "mpesa" (direct Safaricom Daraja) or "paystack" — only that provider's vars below are required

# Safaricom Daraja — required when PAYMENT_PROVIDER=mpesa
MPESA_ENV=sandbox                 # "sandbox" or "production"
MPESA_CONSUMER_KEY=               # Daraja app > APIs > M-Pesa Express
MPESA_CONSUMER_SECRET=            # Daraja app > APIs > M-Pesa Express
MPESA_SHORTCODE=174379            # Paybill/Till number (sandbox default: 174379)
MPESA_PASSKEY=                    # issued alongside the shortcode on the Daraja portal
MPESA_CALLBACK_URL=https://portal.example.com/api/mpesa/callback   # must be public HTTPS — Safaricom posts here directly

# Paystack — required when PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=   # dashboard > Settings > API Keys & Webhooks (sk_test_... or sk_live_...); set the webhook URL there to ${APP_BASE_URL}/api/paystack/webhook

# --- OPNsense captive portal (see docs/OPNSENSE-SETUP.md) ---
OPNSENSE_CAPTIVE_PORTAL_BASE_URL=http://10.0.10.1:8000   # must be the IP of the INTERFACE THE HOTSPOT CLIENTS ARE ON, not OPNsense's LAN/admin IP — confirm via a redirect Location header or the zone's own interface setting, don't assume; HTTP not HTTPS, see OPNSENSE-SETUP.md's §2 cert note

# --- Scheduled RADIUS cleanup (see README's "Scheduled cleanup") ---
RADIUS_CLEANUP_GRACE_MINUTES=10   # minutes past session expiry before RADIUS credentials are deleted
CRON_SECRET=   # bearer token the external scheduler sends to POST /api/radius-cleanup; generate with: openssl rand -base64 32

# --- Staff admin area (see docs/ADMIN.md) ---
ADMIN_PASSWORD=   # single shared password gating /admin, not per-staff accounts yet; generate with: openssl rand -base64 18
