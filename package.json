{
  "name": "wisp-captive-portal",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check",
    "docker:db": "docker compose up -d db",
    "docker:web:build": "docker compose up -d --build web",
    "docker:web:restart": "docker compose restart web",
    "docker:web:stop": "docker compose stop web",
    "docker:web-prod:build": "docker compose --profile prod up -d --build web-prod",
    "docker:web-prod:restart": "docker compose restart web-prod",
    "docker:web-prod:stop": "docker compose stop web-prod",
    "docker:tunnel": "docker compose --profile tunnel up -d tunnel",
    "docker:tunnel-prod": "docker compose --profile tunnel-prod up -d tunnel-prod",
    "docker:named-tunnel": "docker compose --profile named-tunnel up -d named-tunnel",
    "docker:dev": "pnpm docker:db && pnpm docker:web:build",
    "docker:dev:tunnel": "pnpm docker:dev && pnpm docker:tunnel",
    "docker:prod": "pnpm docker:db && pnpm docker:web-prod:build",
    "docker:prod:tunnel": "pnpm docker:prod && pnpm docker:tunnel-prod",
    "docker:prod:named-tunnel": "pnpm docker:prod && pnpm docker:named-tunnel",
    "docker:clean": "docker compose down --volumes --remove-orphans",
    "db:generate": "prisma generate --schema=prisma/app/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=prisma/app/schema.prisma",
    "db:studio": "prisma studio --schema=prisma/app/schema.prisma",
    "db:seed": "tsx prisma/app/seed.ts",
    "radius:pull": "prisma db pull --schema=prisma/radius/schema.prisma",
    "radius:generate": "prisma generate --schema=prisma/radius/schema.prisma",
    "postinstall": "pnpm db:generate && pnpm radius:generate"
  },
  "prisma": {
    "schema": "prisma/app/schema.prisma",
    "seed": "tsx prisma/app/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "6.19.3",
    "shadcn": "^4.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.11.2"
}
