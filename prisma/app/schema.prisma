// This app's own data. Postgres. Migrations are ours (`prisma migrate dev`).
// See docs/RADIUS-INTEGRATION.md for why the radius-side schema is separate.

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/app-client"
  // "native" for the host (pnpm install / pnpm dev), musl for the Alpine containers. The dev
  // container bind-mounts the repo, so it can load a client generated on the host; listing both
  // keeps either one working no matter which side generated it.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PackageDuration {
  HOURLY
  DAILY
  WEEKLY
}

model Package {
  id                String          @id @default(cuid())
  name              String
  duration          PackageDuration
  durationMinutes   Int
  priceKes          Int
  downKbps          Int
  upKbps            Int
  radiusGroup       String?
  isActive          Boolean         @default(true)
  sortOrder         Int             @default(0)
  sessions          PortalSession[]
  // OPNsense Traffic Shaper pipe UUIDs enforcing downKbps/upKbps for this package — see
  // docs/OPNSENSE-SETUP.md#8-traffic-shaper-per-package-speed-limits. Not a RADIUS attribute:
  // OPNsense's captive portal doesn't read any bandwidth field from RADIUS (confirmed against its
  // own source — see that doc section), so speed is enforced OPNsense-side instead. Null until the
  // first subscriber on this package actually connects (created lazily, then cached here).
  shaperDownPipeUuid String?
  shaperUpPipeUuid   String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

enum SessionStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  PROVISIONED
  FAILED
  CANCELLED
  TIMEOUT
  EXPIRED
}

model PortalSession {
  id                 String        @id @default(cuid())
  packageId          String
  package            Package       @relation(fields: [packageId], references: [id])
  phoneNumber        String
  // Optional — customer-supplied. Not required for any provider, but kept for receipts/support
  // lookups; falls back to a generated placeholder address at the point a provider requires one
  // (Paystack's Charge API) rather than being defaulted here.
  email              String?
  clientMac          String?
  clientIp           String?
  zoneId             String?
  redirectUrl        String?
  status             SessionStatus @default(PENDING)
  radiusUsername     String?
  // Set once, right after provisioning; cleared the first time /api/sessions/:id/status serves it
  // to the browser for the auto-login form. Never logged, never kept around after that single read.
  radiusPasswordOneTime String?
  expiresAt          DateTime?
  // The OPNsense shaper rules bound to this subscriber's session (see Package.shaperDownPipeUuid
  // above) — set once the subscriber's browser actually logs into OPNsense (src/app/api/sessions/
  // [id]/apply-shaper/route.ts), torn down by the same cleanup job that removes RADIUS credentials.
  // shaperClientIp is the IP OPNsense itself reported for this subscriber, not the unreliable
  // query-param-sourced clientIp field above.
  shaperClientIp     String?
  shaperDownRuleUuid String?
  shaperUpRuleUuid   String?
  transaction        MpesaTransaction?
  paystackTransaction PaystackTransaction?
  provisionLogs      RadiusProvisionLog[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([status])
  @@index([radiusUsername])
}

enum MpesaStatus {
  INITIATED
  SUCCESS
  FAILED
  CANCELLED
  TIMEOUT
}

model MpesaTransaction {
  id                 String        @id @default(cuid())
  sessionId          String        @unique
  session            PortalSession @relation(fields: [sessionId], references: [id])
  merchantRequestId  String
  checkoutRequestId  String        @unique
  amount             Int
  phoneNumber        String
  status             MpesaStatus   @default(INITIATED)
  resultCode         Int?
  resultDesc         String?
  mpesaReceiptNumber String?
  transactionDate    DateTime?
  rawCallback        Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

enum PaystackStatus {
  INITIATED
  SUCCESS
  FAILED
  CANCELLED
  TIMEOUT
  // Set by a staff-initiated refund (see docs/ADMIN.md) — never set by the webhook/verify-fallback
  // result-application logic, which only ever sets a transaction to a terminal non-refund status once.
  REFUNDED
}

// Mirrors MpesaTransaction's shape (see docs/RADIUS-INTEGRATION.md's "two schemas" philosophy for
// why providers get their own table rather than a shared polymorphic one) — this one tracks a
// Paystack-initiated M-Pesa STK push instead of a direct Daraja one, see docs/PAYSTACK-INTEGRATION.md.
model PaystackTransaction {
  id              String         @id @default(cuid())
  sessionId       String         @unique
  session         PortalSession  @relation(fields: [sessionId], references: [id])
  reference       String         @unique
  amount          Int
  phoneNumber     String
  status          PaystackStatus @default(INITIATED)
  gatewayResponse String?
  paidAt          DateTime?
  rawWebhook      Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model RadiusProvisionLog {
  id        String        @id @default(cuid())
  sessionId String
  session   PortalSession @relation(fields: [sessionId], references: [id])
  action    String // "PROVISION" | "CLEANUP"
  success   Boolean
  error     String?
  createdAt DateTime      @default(now())
}
